  },
  "devDependencies": {
    "@pipecat-ai/client-js": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.2.7"
  }
}
