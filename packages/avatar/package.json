{
  "name": "@voqalize/avatar",
  "version": "0.4.4",
  "description": "A JavaScript-programmable talking head for AI voice calls: line-art or 2.5-D faces, server-synced lipsync, state through motion, no runtime dependencies.",
  "license": "MIT AND CC-BY-4.0 AND Apache-2.0",
  "author": "Voqalize",
  "homepage": "https://github.com/voqalize/avatar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voqalize/avatar.git",
    "directory": "packages/avatar"
  },
  "bugs": {
    "url": "https://github.com/voqalize/avatar/issues"
  },
  "keywords": [
    "avatar",
    "talking-head",
    "lipsync",
    "viseme",
    "rhubarb",
    "pipecat",
    "voice-agent",
    "svg",
    "animation",
    "3d",
    "threejs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./internal/three": {
      "types": "./dist/three/internal.d.ts",
      "default": "./dist/three/internal.js"
    },
    "./faces/peep": {
      "types": "./src/face-peep.d.ts",
      "default": "./src/face-peep.js"
    },
    "./faces/wren": {
      "types": "./src/face-wren.d.ts",
      "default": "./src/face-wren.js"
    },
    "./faces/myna": {
      "types": "./src/face-myna.d.ts",
      "default": "./src/face-myna.js"
    },
    "./avatars/tara": {
      "types": "./dist/three/tara.d.ts",
      "default": "./dist/three/tara.js"
    },
    "./avatars/tushar": {
      "types": "./dist/three/tushar.d.ts",
      "default": "./dist/three/tushar.js"
    },
    "./avatars/tanya": {
      "types": "./dist/three/tanya.d.ts",
      "default": "./dist/three/tanya.js"
    },
    "./avatars/tess": {
      "types": "./dist/three/tess.d.ts",
      "default": "./dist/three/tess.js"
    },
    "./avatars/tanvi": {
      "types": "./dist/three/tanvi.d.ts",
      "default": "./dist/three/tanvi.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "dist",
    "assets",
    "LICENSE-CC-BY-4.0",
    "LICENSE-APACHE-2.0"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@pipecat-ai/client-js": ">=1.4 <2",
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.180 <0.187"
  },
  "peerDependenciesMeta": {
    "@pipecat-ai/client-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "three": "^0.180.0"
  }
}
