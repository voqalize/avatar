{
  "name": "@voqalize/avatar",
  "version": "0.5.5",
  "description": "A talking head for AI voice calls that embodies your pipecat client. This package loads the Voqalize avatar runtime.",
  "license": "MIT",
  "author": "Voqalize",
  "homepage": "https://github.com/voqalize/avatar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voqalize/avatar.git",
    "directory": "packages/avatar"
  },
  "bugs": {
    "url": "https://github.com/voqalize/avatar/issues"
  },
  "keywords": [
    "avatar",
    "talking-head",
    "lipsync",
    "pipecat",
    "voice-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@pipecat-ai/client-js": ">=1.4 <2",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@pipecat-ai/client-js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
