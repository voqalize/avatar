{
  // The published package: the shim, compiled into `dist/`. The runtime it
  // loads is `client/` (its own tsconfig there), bundled separately and never
  // on npm.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "shim",
    "outDir": "dist"
  },
  "include": ["shim"]
}
